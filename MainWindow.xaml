<Window x:Class="WPF_RPM.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:WPF_RPM"
    mc:Ignorable="d"
    Title="БД" Height="500" Width="500"
    WindowStartupLocation="CenterScreen">

    <!-- Контейнер Grid — основной контейнер разметки -->
    <Grid>
        <!-- строки и столбцы -->
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <!-- таблица списка товаров -->
        <DataGrid x:Name="table_Products"
                  Grid.Row="0"
                  Grid.ColumnSpan="2"
                  Margin="10"
                  AutoGenerateColumns="False">
            <!-- отключаем автогенерацию столбцов, чтобы задать их явно -->
            
            <DataGrid.Columns>
                <!-- явное описание столбцов, c привязкой к классу product -->
                <DataGridTextColumn Header="Код"
                                    Binding="{Binding Id}"
                                    Width="40"/>

                <DataGridTextColumn Header="Название"
                                    Binding="{Binding Name}"
                                    Width="*"/>

                <DataGridTextColumn Header="Цена, руб."
                                    Binding="{Binding Price, StringFormat=F2}"
                                    Width="80"/>

                <DataGridTextColumn Header="Кол-во"
                                    Binding="{Binding Quantity}"
                                    Width="80"/>

                <DataGridTextColumn Header="Категория"
                                    Binding="{Binding Category}"
                                    Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- кнопка обновить -->
        <Button x:Name="button_refresh"
                Grid.Row="1"
                Grid.Column="1"
                Content="Обновить"
                Margin="5,5,5,5"
                Click="refresh_click"/>

        <!-- StatusBar c элементами внутри -->
        <StatusBar Grid.Row="1"
                   Grid.Column="0"
                   Margin="5,5,5,5">
            <StatusBarItem>
                <!-- счетчик загруженных записей -->
                <TextBlock x:Name="status"
                           Text="Загружено записей: 0"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>

