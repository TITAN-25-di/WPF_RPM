<Window x:Class="WPF_RPM.ProductEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_RPM"
        mc:Ignorable="d"
        Title="ProductEditWindow" Height="450" Width="800">
    <Grid Margin="10">
        <!-- строки и столбцы -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="90"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- название -->
        <TextBlock Grid.Row="0" 
                   Grid.Column="0" 
                   Text="название:" 
                   Margin="0,5"/>
        <TextBox x:Name="product_name" 
                 Grid.Row="0" 
                 Grid.Column="1" 
                 Margin="0,5"/>

        <!-- цена -->
        <TextBlock Grid.Row="1" 
                   Grid.Column="0" 
                   Text="цена:" 
                   Margin="0,5"/>
        <TextBox x:Name="product_price" 
                 Grid.Row="1" 
                 Grid.Column="1" 
                 Margin="0,5"/>

        <!-- количество -->
        <TextBlock Grid.Row="2" 
                   Grid.Column="0" 
                   Text="количество:" 
                   Margin="0,5"/>
        <TextBox x:Name="product_quantity" 
                 Grid.Row="2" 
                 Grid.Column="1" 
                 Margin="0,5"/>

        <!-- категория -->
        <TextBlock Grid.Row="3" 
                   Grid.Column="0" 
                   Text="категория:" 
                   Margin="0,5"/>
        <ComboBox x:Name="product_category" 
                  Grid.Row="3" 
                  Grid.Column="1" 
                  Margin="0,5"/>
        
        <!-- описание -->
        <TextBlock Grid.Row="4" 
                   Grid.Column="0" 
                   Text="описание:" 
                   Margin="0,5" 
                   VerticalAlignment="Top"/>
        <TextBox x:Name="product_description" 
                 Grid.Row="4" 
                 Grid.Column="1" 
                 Margin="0,5"
                 AcceptsReturn="True" 
                 TextWrapping="Wrap"/>

        <!-- панель с кнопками -->
        <StackPanel Grid.Row="5" 
                    Grid.ColumnSpan="2" 
                    Orientation="Horizontal"
                    HorizontalAlignment="Right" 
                    Margin="0,10,10,0">
            <!-- кнопки -->
            <Button x:Name="button_save"
                    Content="Сохранить"
                    Margin="5,10,5,10"
                    IsDefault="True"
                    Click="save_click"/>
            <Button x:Name="button_cancel" 
                    Content="Отмена"
                    Margin="5,10,5,10"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
